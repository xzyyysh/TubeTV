<?xml version="1.0" encoding="utf-8"?>
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <font
        android:fontStyle="normal"
        android:fontWeight="300"
        android:font="@font/ubuntu_light"
        tools:targetApi="26"
        app:fontStyle="normal"
        app:fontWeight="300"
        app:font="@font/ubuntu_light" />

    <font
        android:fontStyle="italic"
        android:fontWeight="300"
        android:font="@font/ubuntu_light_italic"
        tools:targetApi="26"
        app:fontStyle="italic"
        app:fontWeight="300"
        app:font="@font/ubuntu_light_italic" />

    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:font="@font/ubuntu_regular"
        tools:targetApi="26"
        app:fontStyle="normal"
        app:fontWeight="400"
        app:font="@font/ubuntu_regular" />

    <font
        android:fontStyle="italic"
        android:fontWeight="400"
        android:font="@font/ubuntu_italic"
        tools:targetApi="26"
        app:fontStyle="italic"
        app:fontWeight="400"
        app:font="@font/ubuntu_italic" />

    <font
        android:fontStyle="normal"
        android:fontWeight="500"
        android:font="@font/ubuntu_medium"
        tools:targetApi="26"
        app:fontStyle="normal"
        app:fontWeight="500"
        app:font="@font/ubuntu_medium" />

    <font
        android:fontStyle="italic"
        android:fontWeight="500"
        android:font="@font/ubuntu_medium_italic"
        tools:targetApi="26"
        app:fontStyle="italic"
        app:fontWeight="500"
        app:font="@font/ubuntu_medium_italic" />

    <font
        android:fontStyle="normal"
        android:fontWeight="700"
        android:font="@font/ubuntu_bold"
        tools:targetApi="26"
        app:fontStyle="normal"
        app:fontWeight="700"
        app:font="@font/ubuntu_bold" />

    <font
        android:fontStyle="italic"
        android:fontWeight="700"
        android:font="@font/ubuntu_bold_italic"
        tools:targetApi="26"
        app:fontStyle="italic"
        app:fontWeight="700"
        app:font="@font/ubuntu_bold_italic" />

</font-family>
